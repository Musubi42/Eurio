# Ce fichier est committé. Aucun secret en clair ne doit y être écrit ;
# les secrets vivent dans `secrets/dev.env` (chiffré via SOPS+age) et sont
# déchiffrés au chargement du shell.

# 1) Charge le devShell Nix selon le hostname.
case "$(hostname -s)" in
  Musubi42s-MacBook-Air-Oim) use flake .#mac ;;
  desktop)                   use flake .#pc  ;;
  nixos)                     use flake .#vps ;;
  *)
    echo "" >&2
    echo "❌ Hostname inconnu pour Eurio : $(hostname -s)" >&2
    echo "" >&2
    echo "Profils disponibles : mac | pc | vps" >&2
    echo "" >&2
    echo "Pour cette machine, soit :" >&2
    echo "  1. Ajouter '$(hostname -s)' au case dans .envrc" >&2
    echo "  2. Forcer un profil ponctuellement (gitignore conseillé) :" >&2
    echo "       echo 'use flake .#vps' > .envrc.local && direnv allow" >&2
    echo "" >&2
    exit 1
    ;;
esac

# 2) Déchiffre les secrets et les exporte dans le shell.
#    Lit ~/.config/sops/age/keys.txt automatiquement (clé privée de la machine).
if [ -f secrets/dev.env ]; then
  set -a
  source <(sops -d secrets/dev.env)
  set +a
else
  echo "⚠️  secrets/dev.env absent — voir README.md §Secrets pour le bootstrap." >&2
fi

# 2b) Alias PAT → variable préfixée VITE_ (seul préfixe que Vite expose au
#     navigateur). Source UNIQUE = EURIO_API_TOKEN (secrets/dev.env) ; le front
#     studio-local lit VITE_EURIO_PAT depuis l'environnement shell — plus aucun
#     .env.local à tenir en doublon (qui driftait et expirait en douce).
if [ -n "${EURIO_API_TOKEN:-}" ]; then
  export VITE_EURIO_PAT="$EURIO_API_TOKEN"
fi

# 3) Active le venv ml/ pour que `python`, `uvicorn`, `pytest` etc. pointent
#    vers le bon interpréteur sans avoir à l'invoquer en chemin absolu.
#    direnv capture l'activation à ce moment (PATH inclus) et la restaure à
#    chaque précmd — donc plus de désync où `(.venv)` s'affiche dans le prompt
#    mais `which python` renvoie le python Nix env.
#    Si le venv est absent ou stale, voir staleVenvCheckHook dans flake.nix
#    qui suggère `go-task ml:venv-rebuild`.
if [ -f ml/.venv/bin/activate ]; then
  source ml/.venv/bin/activate
fi