# Template Eurio — copier dans `.envrc` puis `direnv allow`.
#
# Ce fichier est committé. Aucun secret en clair ne doit y être écrit ;
# les secrets vivent dans `secrets/dev.env` (chiffré via SOPS+age) et sont
# déchiffrés au chargement du shell.

# 1) Charge le devShell Nix selon le hostname.
case "$(hostname -s)" in
  Musubi42s-MacBook-Air-Oim) use flake .#mac ;;
  desktop)                   use flake .#pc  ;;
  nixos)                     use flake .#vps ;;
  *)
    echo "" >&2
    echo "❌ Hostname inconnu pour Eurio : $(hostname -s)" >&2
    echo "" >&2
    echo "Profils disponibles : mac | pc | vps" >&2
    echo "" >&2
    echo "Pour cette machine, soit :" >&2
    echo "  1. Ajouter '$(hostname -s)' au case dans .envrc" >&2
    echo "  2. Forcer un profil ponctuellement (gitignore conseillé) :" >&2
    echo "       echo 'use flake .#vps' > .envrc.local && direnv allow" >&2
    echo "" >&2
    exit 1
    ;;
esac

# 2) Déchiffre les secrets et les exporte dans le shell.
#    Lit ~/.config/sops/age/keys.txt automatiquement (clé privée de la machine).
#
#    ⚠️ Lecture ligne à ligne, PAS `set -a` + `source`. Le `source` fait
#    interpréter les valeurs par bash : une valeur portant une parenthèse
#    coupe le chargement en plein milieu, et toutes les variables situées
#    après elle dans le fichier ne sont jamais exportées — sans autre signe
#    qu'un message noyé dans la sortie de direnv (trouvé le 2026-09-11).
#    Le fichier est un dotenv plat produit par SOPS (`CLE=valeur`, jamais de
#    quotes, jamais de multi-ligne) : `export "$k=$v"` a exactement la même
#    sémantique, sans passer par le parseur shell.
if [ -f secrets/dev.env ]; then
  while IFS= read -r _sops_line; do
    case "$_sops_line" in
      ''|'#'*) continue ;;
      *=*) ;;
      *) continue ;;
    esac
    export "${_sops_line%%=*}=${_sops_line#*=}"
  done < <(sops -d --input-type dotenv --output-type dotenv secrets/dev.env)
  unset _sops_line
else
  echo "⚠️  secrets/dev.env absent — voir README.md §Secrets pour le bootstrap." >&2
fi
