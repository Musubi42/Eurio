# ───────────────────────────────────────────────────────────────────────
# infra/ — MinIO data, secrets, rclone config (NEVER commit any of these)
# Spec: docs/harmonisation-images/vision.md, infra/minio/README.md
# ───────────────────────────────────────────────────────────────────────

# MinIO bucket data (the volume mounted into the eurio-minio container).
# Keep the .do-not-delete marker so the dir exists at clone time.
infra/minio/data/*
!infra/minio/data/.do-not-delete

# MinIO credentials (root + eurio-app), generated by infra/minio/bootstrap.sh.
# Keep .gitkeep so the dir exists at clone time.
infra/minio/secrets/*
!infra/minio/secrets/.gitkeep

# rclone OAuth token for pCloud. The redacted template lives at
# infra/backup/rclone.conf.example.
infra/backup/rclone.conf

# Bundle cohortTest — artefact par-itération régénéré par `cohort-test:bundle`
# (modèle .tflite ~4 Mo + embeddings + manifest). Régénérable localement avant
# build de l'APK de test ; sorti de git pour éviter le churn binaire.
app-android/src/cohortTest/assets/cohort_bundle/

# Artefacts runtime (ne pas committer — churn)
build/
ml/.task/
ml/state/bce_runs/
ml/state/lmdlp_runs/
ml/state/*.log
ml/state/*_worklist.json

# graphify knowledge-graph output (regenerable, large)
graphify-out/

# Images/HTML de bench sous ml/state — régénérables, sortis de git (cleanup Codeberg).
# Les .jsonl/.json gold/seed/ground_truth restent trackés (pas de pattern image).
ml/state/**/*.png
ml/state/**/*.jpg
ml/state/**/*.jpeg
ml/state/**/*.webp
ml/state/**/*.html

# Services globaux partagés (ccproxy, …) — source UNIQUE ~/Documents/Musubi42/infra/*.
# Règle globale : ne JAMAIS re-vendorer/dupliquer un service global par projet ; un
# projet qui en a besoin pointe vers l'instance déjà lancée. Garde anti-réintroduction
# (un `services/ccproxy` copié en local est apparu côté PC — incident 2026-07-05).
/services/
