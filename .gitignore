ml/state/*.npz
ml/state/*.npz.bak-*
ml/state/bench_*.csv
ml/state/i18n_review_report.md
# Images canoniques générées localement par scripts/migrate_canonical_images_local.py.
# Régénérables depuis eurio.db (coin_canonical_images.url) — pas besoin de versionner.
ml/canonical_images/
ml/state/eurio.db
ml/state/eurio.db-wal
ml/state/eurio.db-shm
ml/state/eurio.db.bak-*
# Réplique read-only Modèle B (copie du canonique tirée de MinIO, jamais versionnée)
ml/state/eurio.replica.db
ml/state/eurio.replica.db-wal
ml/state/eurio.replica.db-shm
# Artefacts runtime du transport réplique (générés à chaque pull, jamais versionnés)
ml/state/.replica_ssh.sh
ml/state/.replica_known_hosts
ml/state/replica.lock
ml/state/.replica-last-pull
# Corpus de scan rejouable — lab PC-only, ne voyage jamais (scan-quality/corpus-spec.md §4)
ml/state/scan_corpus.db
ml/state/scan_corpus.db-wal
ml/state/scan_corpus.db-shm
ml/state/scan_corpus/
# Baselines épinglées du funnel scan-quality (bundles gelés, binaires lourds — corpus-spec §9)
ml/state/scan_baselines/
# Candidats d'expérience + sorties replay (scorecards/predictions régénérables)
ml/state/scan_experiments/
ml/state/scan_corpus_runs/
# État local inscriptible (observabilité jobs) — distinct de la réplique, jamais versionné
ml/state/eurio.local.db
ml/state/eurio.local.db-wal
ml/state/eurio.local.db-shm
ml/state/numista_cache/
# ml/state/cohort_csvs/
# Sources refacto — local-only, each machine autonomous (decisions.md D-06)
ml/state/sources_runs.json
ml/state/quotas/
ml/state/price_snapshots/
# Runtime: logs par job/run (recrop subprocess + source_runs) — régénérables.
ml/state/job_logs/
ml/state/run_logs/
ml/datasets/sources/
# Runtime: raws + crops downloaded by the orchestrator (D-13).
ml/state/sources/
# Census fragment-probe dataset (local bench crops + contact sheets ; the small
# model state/fragment_face_probe.npz IS versioned, like foundation_coinness.npz).
ml/state/fragment_probe/

# Claude Code internal worktrees
.claude/worktrees/
ml/cache/dinov2_inputs/*.webp

