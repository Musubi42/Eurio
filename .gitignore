ml/state/training.db.bak-*
ml/state/eurio.db.bak-*
ml/state/eurio.db.fix-attempt-*
ml/state/eurio.db.pre-*
ml/state/.tcc-write-probe
# Sorties de run/probe en vrac à la racine de state/.
ml/state/*.log
ml/state/*_results.jsonl
ml/state/i18n_*.jsonl
ml/state/i18n_*.json
ml/state/aliases_*.jsonl
ml/state/probe_*.json
