# Secrets
.env
.env.local
.env.*.local
local.properties

# Nix
result
.direnv/

# IDE
.idea/

# OS
.DS_Store

# Gradle
.gradle/

# `.envrc` est désormais committable (template `.envrc.example`).
# Les secrets vivent dans `secrets/dev.env` (chiffré via SOPS+age).
# Override local optionnel uniquement.
.envrc.local
# Garde-fou anti-fuite : toute copie/variante d'.envrc (ex. `.envrc copy`) contient
# des secrets en clair et ne doit JAMAIS être trackée.
.envrc copy
.envrc*copy*
*.envrc.bak

# Filament toolchain (matc) — installed locally via `go-task filament:install-matc`,
# pinned to v1.71.0 to match the runtime shipped in SceneView 4.0.0.
tools/filament/

# Compiled Filament materials — generated from app-android/src/main/materials/*.mat
# by `go-task filament:compile-materials` (auto-run by Gradle preBuild).
app-android/src/main/assets/materials/

# Offline core (C3) — generated from Supabase by `go-task ml:build-app-core`.
# The Android prebuilt SQLite IS committed (packaged in the APK, reproducible
# builds without Supabase access). The proto JSON copy stays gitignored.

# ML artifacts
# Heavy ML training datasets (images, embeddings, etc.) — keep referential and snapshots
ml/datasets/*
# !ml/datasets/eurio_referential.json
# !ml/datasets/country_mapping.json
# !ml/datasets/sources/
# ml/datasets/sources/*
# !ml/datasets/sources/*.html
# !ml/datasets/sources/*.json
# !ml/datasets/sources/*.jsonl
ml/__pycache__/
ml/*.pth
ml/*.tflite
ml/*.npy
ml/checkpoints/
ml/output/
# Artefacts de run du lab (modèle/tflite/embeddings/previews/manifests par itération)
# — régénérables, nettoyés à la suppression de l'itération (cf. delete_iteration).
ml/lab/iterations/
# Caches régénérables : sources d'augmentation, embeddings/inputs DINO, status.
ml/cache/
# Rapports de benchmark + résidu de chemin par défaut.
ml/training/reports/
ml/training/state/
ml/yolov8n.pt
# Poids SAM auto-téléchargés par ultralytics (proposeurs-objet du bench census).
ml/mobile_sam.pt
ml/FastSAM*.pt
ml/sam2*.pt
# Cache de token OAuth eBay (secret runtime) — peut vivre à la racine ml/ ou sous sources/.
ml/.ebay_token_cache.json
ml/**/.ebay_token_cache.json
ml/.dataset_cache/
# Artefacts de progression d'entraînement (runtime, régénérés).
ml/state/training_progress/
# Artefacts de run/bench ML sortis de git (chunk 8) — gardés sur disque, régénérables.
# Le gold/seed reste tracké (exceptions ! ci-dessous).
# Bench best-frame-capture (chunk 7) : sessions + ground_truth.json restent
# trackés (données primaires) ; replays et rapports sont dérivés.
ml/bench/sessions/**/replays/
ml/bench/reports/
ml/state/device_bimetal_bench/
ml/state/listing_bimetal_bench/
ml/state/listing_bench/
ml/state/ablation_eval/
ml/state/crop_diag/
ml/state/coin_census_bench/
ml/state/bce_runs/
ml/state/live_test_logs/
ml/state/fragment_probe/
ml/state/numista_cache/
ml/state/run_logs/
ml/state/job_logs/
ml/state/crop_scores/
!ml/state/crop_scores/gold/
ml/state/discovery_bench/
!ml/state/discovery_bench/gold_images.jsonl
!ml/state/discovery_bench/theme_match_gold.jsonl
# training.db = vestige (plus ouvert) — sorti de git, à supprimer du disque au besoin.
ml/state/training.db
