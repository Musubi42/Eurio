# Secrets
.env
local.properties

# Nix
result
.direnv/

# IDE
.idea/

# OS
.DS_Store

# Gradle
.gradle/

# `.envrc` est désormais committable (template `.envrc.example`).
# Les secrets vivent dans `secrets/dev.env` (chiffré via SOPS+age).
# Override local optionnel uniquement.
.envrc.local

# Filament toolchain (matc) — installed locally via `go-task filament:install-matc`,
# pinned to v1.71.0 to match the runtime shipped in SceneView 4.0.0.
tools/filament/

# Compiled Filament materials — generated from app-android/src/main/materials/*.mat
# by `go-task filament:compile-materials` (auto-run by Gradle preBuild).
app-android/src/main/assets/materials/

# Offline core (C3) — generated from Supabase by `go-task ml:build-app-core`.
# The Android prebuilt SQLite IS committed (packaged in the APK, reproducible
# builds without Supabase access). The proto JSON copy stays gitignored.

# ML artifacts
# Heavy ML training datasets (images, embeddings, etc.) — keep referential and snapshots
ml/datasets/*
# !ml/datasets/eurio_referential.json
# !ml/datasets/country_mapping.json
# !ml/datasets/sources/
# ml/datasets/sources/*
# !ml/datasets/sources/*.html
# !ml/datasets/sources/*.json
# !ml/datasets/sources/*.jsonl
ml/__pycache__/
ml/*.pth
ml/*.tflite
ml/*.npy
ml/checkpoints/
ml/output/
ml/yolov8n.pt
# Poids SAM auto-téléchargés par ultralytics (proposeurs-objet du bench census).
ml/mobile_sam.pt
ml/FastSAM*.pt
ml/sam2*.pt
ml/.ebay_token_cache.json
ml/.dataset_cache/
# Images canoniques générées localement par scripts/migrate_canonical_images_local.py.
# Régénérables depuis eurio.db (coin_canonical_images.url) — pas besoin de versionner.
ml/canonical_images/
ml/state/eurio.db
ml/state/eurio.db-wal
ml/state/eurio.db-shm
ml/state/eurio.db.bak-*
ml/state/numista_cache/
# ml/state/cohort_csvs/
# Sources refacto — local-only, each machine autonomous (decisions.md D-06)
ml/state/sources_runs.json
ml/state/quotas/
ml/state/price_snapshots/
ml/datasets/sources/
# Runtime: raws + crops downloaded by the orchestrator (D-13).
ml/state/sources/

# Claude Code internal worktrees
.claude/worktrees/
ml/cache/dinov2_inputs/*.webp

# Real-photo benchmark hold-out — NEVER committed. These photos are the
# ground truth for PRD Bloc 3 and must remain strictly off-training (see
# `docs/augmentation-benchmark/03-real-photo-benchmark.md §7 R1`).
ml/data/real_photos/
ml/reports/

# YOLO training env + outputs (NixOS 1080 Ti)
yolo_env/
runs/
yolo*.pt

# App test/temp models
app-android/src/main/assets/models/test_model.tflite
# ml/debug_captures/eurio_debug

# Debug captures pulled from device (via `go-task android:pull-debug`)
debug_pull/

# Bench / parity test outputs (rework normalize)
ml/tests/_bench_out/
ml/tests/_bench_smoke/
ml/tests/_parity_out/

# Python
__pycache__/
*.pyc
.venv/

# Kotlin build errors
.kotlin/

# Node
node_modules/
dist/
.vite/

# Screenshots at root
Screenshot_*.png

# Parity screenshots (captured locally, not committed)
admin/packages/parity/screenshots/proto/*
!admin/packages/parity/screenshots/proto/.gitignore
admin/packages/parity/screenshots/android/*
!admin/packages/parity/screenshots/android/.gitignore

# ───────────────────────────────────────────────────────────────────────
# infra/ — MinIO data, secrets, rclone config (NEVER commit any of these)
# Spec: docs/harmonisation-images/vision.md, infra/minio/README.md
# ───────────────────────────────────────────────────────────────────────

# MinIO bucket data (the volume mounted into the eurio-minio container).
# Keep the .do-not-delete marker so the dir exists at clone time.
infra/minio/data/*
!infra/minio/data/.do-not-delete

# MinIO credentials (root + eurio-app), generated by infra/minio/bootstrap.sh.
# Keep .gitkeep so the dir exists at clone time.
infra/minio/secrets/*
!infra/minio/secrets/.gitkeep

# rclone OAuth token for pCloud. The redacted template lives at
# infra/backup/rclone.conf.example.
infra/backup/rclone.conf

# Artefacts runtime (ne pas committer — churn)
build/
ml/.task/
ml/state/bce_runs/
ml/state/lmdlp_runs/
ml/state/*.log
ml/state/*_worklist.json
