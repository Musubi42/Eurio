# Template plaintext des secrets attendus par l'app et les outils.
# La version chiffrée vraie de ce fichier est `secrets/dev.env` (SOPS+age).
# Voir README.md §Secrets pour le bootstrap.

# Supabase (admin web + ML pipeline)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase côté Vite (admin web) — Vite ne lit que les VITE_*
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_SERVICE_KEY=eyJ...

# Numista API (ML — sources scraping)
NUMISTA_API_KEY_MUSUBI00=xxxxx
NUMISTA_API_KEY_MUSUBI01=xxxxx

# eBay API (ML — price scraping)
EBAY_CLIENT_ID=xxxxx
EBAY_CLIENT_SECRET=xxxxx

# MinIO (image storage — VPS native docker)
# Host-only (no scheme/path) — the MinIO Go SDK rejects full URLs.
# boto3 reconstructs the URL from MINIO_USE_SSL in ml/storage.
MINIO_ENDPOINT=minio.example.com
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=xxxxx
MINIO_SECRET_KEY=xxxxx
