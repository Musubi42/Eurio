# Eurio panel — variables d'env (dev local).
# Aucun .env tracké : copier/source via direnv (cf. ../../../.envrc).
# Pour des overrides locaux uniquement, créer `.env.local` (gitignored).

# Base URL de l'API. En dev local pointer sur eurio-api containerisé (8042 via
# reverse-proxy local) ou directement le VPS si pas de stack locale.
VITE_EURIO_API_BASE=http://localhost:8042

# Mode dev bypass : 1 active le bouton "Dev login" sur la page /login (cf.
# C5 §6.1). Le backend doit aussi avoir EURIO_DEV_BYPASS=1.
VITE_EURIO_DEV_BYPASS=0
